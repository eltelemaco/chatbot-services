# Public domain each service is served on — used for CORS (ALLOWED_ORIGINS),
# Caddy site routing, and the outbound HTTP-Referer header sent to the LLM provider.
BARBER_DOMAIN=barber.example.com
RESTAURANT_DOMAIN=restaurant.example.com

# Docker Hub namespace images are built/pushed/pulled under.
# Must be your bare Docker Hub username/org (2-segment image names only,
# e.g. "yourdockerhubuser" — NOT "yourdockerhubuser/somerepo").
DOCKERHUB_REPO=yourdockerhubuser

# LLM provider endpoint/model, OpenAI-compatible API. Defaults to OpenRouter +
# Amazon Nova Lite; override to point at a different OpenRouter model or a
# different OpenAI-compatible provider entirely.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=amazon/nova-lite-v1
